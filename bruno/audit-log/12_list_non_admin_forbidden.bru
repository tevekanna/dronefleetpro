meta {
  name: 12 Non-admin → 403 on list
  type: http
  seq: 12
}

get {
  url: {{base_url}}/api/v1/audit-log
  body: none
  auth: bearer
}

auth:bearer {
  token: {{non_admin_token}}
}

tests {
  test("status is 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
  test("error mentions admin", function() {
    const body = res.getBody();
    expect(body).to.have.property('error');
    expect(String(body.error).toLowerCase()).to.contain('admin');
  });
}
