meta {
  name: 00 Login (seeds access_token)
  type: http
  seq: 0
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@dronefleetpro.local",
    "password": "dronefleet2025"
  }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody() && res.getBody().token) {
    bru.setEnvVar("access_token", res.getBody().token);
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("token stored", function() {
    expect(bru.getEnvVar("access_token")).to.be.a('string').and.not.empty;
  });
}
