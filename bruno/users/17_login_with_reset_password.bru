meta {
  name: 17 New password from reset works
  type: http
  seq: 17
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{created_user_email}}",
    "password": "reset-password-12345"
  }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().token) {
    bru.setEnvVar("created_user_token", res.getBody().token);
  }
}

tests {
  test("status is 200", function() { expect(res.getStatus()).to.equal(200); });
}
