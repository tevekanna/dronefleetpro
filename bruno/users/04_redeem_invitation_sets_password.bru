meta {
  name: 04 Redeem invitation token sets password and consumes token
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/auth/redeem-token
  body: json
  auth: none
}

body:json {
  {
    "token": "{{invitation_token}}",
    "new_password": "redeemed-password-12345"
  }
}

tests {
  test("status is 204", function() { expect(res.getStatus()).to.equal(204); });
}
