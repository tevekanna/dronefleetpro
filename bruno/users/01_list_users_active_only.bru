meta {
  name: 01 List users — default returns active only
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() { expect(res.getStatus()).to.equal(200); });
  test("response is an array", function() { expect(res.getBody()).to.be.an('array'); });
  test("every returned user is active", function() {
    res.getBody().forEach(u => expect(u.is_active).to.equal(true));
  });
  test("each user has the expected fields", function() {
    if (res.getBody().length > 0) {
      const u = res.getBody()[0];
      ['id','org_id','name','email','user_code','role','is_active','deactivated_at','pilot_id','pilot_name','last_login_at','created_at']
        .forEach(f => expect(u).to.have.property(f));
    }
  });
}
