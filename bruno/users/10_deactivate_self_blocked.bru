meta {
  name: 10 Admin cannot deactivate themselves
  type: http
  seq: 10
}

script:pre-request {
  const t = bru.getEnvVar("access_token");
  const payload = JSON.parse(atob(t.split('.')[1]));
  bru.setVar("admin_self_id", String(payload.sub));
}

delete {
  url: {{base_url}}/api/v1/users/{{admin_self_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 409 (Conflict)", function() { expect(res.getStatus()).to.equal(409); });
  test("error mentions own account", function() {
    expect(res.getBody().error.toLowerCase()).to.contain('your own account');
  });
}
