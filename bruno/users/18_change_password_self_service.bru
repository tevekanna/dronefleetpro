meta {
  name: 18 Self-service password change
  type: http
  seq: 18
}

post {
  url: {{base_url}}/api/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{created_user_token}}
}

body:json {
  {
    "current_password": "reset-password-12345",
    "new_password": "self-service-changed-12345"
  }
}

tests {
  test("status is 204", function() { expect(res.getStatus()).to.equal(204); });
}
