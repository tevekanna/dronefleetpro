meta {
  name: 07 Re-redeeming the now-consumed invitation token returns 400
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/auth/redeem-token
  body: json
  auth: none
}

body:json {
  {
    "token": "{{invitation_token}}",
    "new_password": "should-not-work-12345"
  }
}

tests {
  test("status is 400", function() { expect(res.getStatus()).to.equal(400); });
  test("generic error", function() {
    expect(res.getBody().error.toLowerCase()).to.contain('invalid or expired token');
  });
}
