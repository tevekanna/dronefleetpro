meta {
  name: 20 Login as the solo admin of test org (seeds solo_admin_token)
  type: http
  seq: 20
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "purge-audit@test.local",
    "password": "dronefleet2025"
  }
}

docs {
  Reuses the test-org admin seeded by the purge-audit Bruno suite. That org
  contains exactly one admin user, which lets us exercise the last-admin
  guard without breaking the main org.

  If the fixture is missing, seed via psql:

    INSERT INTO organisations (name, slug)
    VALUES ('_purge_audit_test_', '_purge_audit_test_')
    ON CONFLICT (slug) DO NOTHING;

    INSERT INTO users (org_id, name, email, user_code, password_hash, role, is_active)
    SELECT o.id, 'Purge Audit Admin', 'purge-audit@test.local', 'PAU',
           '$2b$12$7T3ErfyTki4vQSnnFP6Spuw39JbFFRzMsrdsH/ZIFHgQrs0mJ13h.',
           'admin', TRUE
    FROM organisations o WHERE o.slug = '_purge_audit_test_'
    ON CONFLICT (org_id, email) DO UPDATE SET role='admin', is_active=TRUE;
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().token) {
    bru.setEnvVar("solo_admin_token", res.getBody().token);
    const payload = JSON.parse(atob(res.getBody().token.split('.')[1]));
    bru.setEnvVar("solo_admin_id", String(payload.sub));
  }
}

tests {
  test("status is 200", function() { expect(res.getStatus()).to.equal(200); });
  test("token + id captured", function() {
    expect(bru.getEnvVar("solo_admin_token")).to.be.a('string').and.not.empty;
    expect(bru.getEnvVar("solo_admin_id")).to.be.a('string').and.not.empty;
  });
}
