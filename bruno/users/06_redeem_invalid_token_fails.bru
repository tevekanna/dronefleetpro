meta {
  name: 06 Redeem with random token returns 400
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/auth/redeem-token
  body: json
  auth: none
}

body:json {
  {
    "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "new_password": "another-password-12345"
  }
}

tests {
  test("status is 400", function() { expect(res.getStatus()).to.equal(400); });
  test("error message is generic", function() {
    expect(res.getBody().error.toLowerCase()).to.contain('invalid or expired token');
  });
}
