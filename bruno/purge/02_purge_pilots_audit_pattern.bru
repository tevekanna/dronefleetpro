meta {
  name: 02 purge_pilots emits per-row + bulk-update audit rows
  type: http
  seq: 2
}

delete {
  url: {{base_url}}/api/v1/admin/purge/pilots
  body: none
  auth: bearer
}

auth:bearer {
  token: {{purge_admin_token}}
}

docs {
  Verifies the audit pattern from fas 1.5: cascade-children get explicit per-row
  DELETE audit rows, and bulk FK-nullify UPDATEs get one summary audit row each
  (skipped when 0 rows affected).

  Re-seed required between runs (purge is destructive):

    DELETE FROM pilot_qualifications WHERE pilot_id IN (SELECT id FROM pilots WHERE org_id = (SELECT id FROM organisations WHERE slug = '_purge_audit_test_'));
    DELETE FROM flights WHERE org_id = (SELECT id FROM organisations WHERE slug = '_purge_audit_test_');
    DELETE FROM pilots WHERE org_id = (SELECT id FROM organisations WHERE slug = '_purge_audit_test_');

    WITH org AS (SELECT id FROM organisations WHERE slug = '_purge_audit_test_'),
         np AS (
           INSERT INTO pilots (org_id, name, license_type)
           SELECT id, 'Test Pilot', 'A2' FROM org RETURNING id, org_id
         )
    INSERT INTO pilot_qualifications (org_id, pilot_id, type_name, issued_date)
    SELECT np.org_id, np.id, q.tname, '2026-01-01'::date
    FROM np, (VALUES ('A2 EASA Certificate'), ('BVLOS Authorization')) AS q(tname);

  After seeding the test org has: 1 pilot, 2 qualifications, 0 flights, 0 incidents.
  After purge expects audit rows: 2 × pilot_qualifications DELETE + 1 × pilots DELETE.
  No bulk_update rows (no flights/incidents to nullify).
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("response reports 1 pilot deleted", function() {
    expect(res.getBody()).to.deep.equal({ deleted: 1, table: "pilots" });
  });
}
