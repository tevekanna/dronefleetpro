meta {
  name: 01 Snapshot bulk_update audit count for the test org
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/audit-log?table_name=flights&action=UPDATE&search=bulk_update&per_page=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{purge_admin_token}}
}

docs {
  audit_log is immutable, so prior runs (or sibling tests) may have left
  bulk_update entries in the test org's history. Capture the baseline before
  the purge so test 04 can verify this purge contributed exactly zero new
  entries (the fixture has no flights, so the UPDATE is a no-op and the
  audit summary is correctly skipped).
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("bulk_update_baseline", String(res.getBody().total));
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("baseline captured", function() {
    expect(bru.getEnvVar("bulk_update_baseline")).to.be.a('string').and.not.empty;
  });
}
