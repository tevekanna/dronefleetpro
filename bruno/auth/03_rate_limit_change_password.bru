meta {
  name: 03 change_password limiter — 11th wrong-current attempt is 429 for the same user
  type: http
  seq: 3
}

script:pre-request {
  // Need an authenticated user to call change_password. Create a fresh
  // throwaway user via the admin token, redeem its invitation, sign in,
  // then drive 10 wrong-current attempts. The 11th is the body of this .bru.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('base_url');
  const adminToken = bru.getEnvVar('access_token');
  if (!adminToken) throw new Error("admin access_token missing — run 00 first");

  async function call(method, path, body, token) {
    const headers = token ? { Authorization: `Bearer ${token}` } : {};
    try {
      const r = await axios({ method, url: `${baseUrl}${path}`, data: body, headers });
      return { status: r.status, body: r.data };
    } catch (e) {
      if (e.response) return { status: e.response.status, body: e.response.data };
      throw e;
    }
  }

  const stamp = `${Date.now()}-${Math.floor(Math.random() * 1e6)}`;
  const email = `bruno-rl-cpw-${stamp}@dronefleetpro.local.test`;
  const A = String.fromCharCode(65 + Math.floor(Math.random() * 26));
  const B = String.fromCharCode(65 + Math.floor(Math.random() * 26));
  const C = String.fromCharCode(65 + Math.floor(Math.random() * 26));
  const userCode = `${A}${B}${C}`;

  const created = await call('post', '/api/v1/users',
    { name: 'Bruno RL CPW', email, user_code: userCode, role: 'viewer' },
    adminToken);
  if (created.status !== 200) {
    throw new Error(`create user: status ${created.status} body=${JSON.stringify(created.body)}`);
  }
  const invitation = created.body.invitation_token;
  const initialPassword = `bruno-init-${stamp}-aaaa`;

  const redeem = await call('post', '/api/v1/auth/redeem-token',
    { token: invitation, new_password: initialPassword }, null);
  if (redeem.status !== 204) {
    throw new Error(`redeem: status ${redeem.status} body=${JSON.stringify(redeem.body)}`);
  }

  const login = await call('post', '/api/v1/auth/login',
    { email, password: initialPassword }, null);
  if (login.status !== 200) {
    throw new Error(`login as new user: status ${login.status}`);
  }
  bru.setEnvVar("rl_cpw_token", login.body.token);

  // Drive 10 wrong-current attempts. Backend returns 400 on each.
  for (let i = 0; i < 10; i++) {
    const r = await call('post', '/api/v1/auth/change-password',
      { current_password: 'definitely-not-it', new_password: 'replacement-password-12345' },
      login.body.token);
    if (r.status !== 400) {
      throw new Error(`cpw attempt ${i + 1}: expected 400, got ${r.status}`);
    }
  }
}

post {
  url: {{base_url}}/api/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{rl_cpw_token}}
}

body:json {
  {
    "current_password": "definitely-not-it",
    "new_password": "replacement-password-12345"
  }
}

tests {
  test("11th change_password attempt is 429", function() {
    expect(res.getStatus()).to.equal(429);
  });
  test("body has retry_after_seconds", function() {
    const body = res.getBody();
    expect(body).to.have.property('retry_after_seconds');
    expect(body.retry_after_seconds).to.be.a('number').and.to.be.above(0);
  });
}
