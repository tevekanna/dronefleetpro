meta {
  name: 05 List Schedules Filter by Aircraft
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/maintenance-schedules?aircraft_id={{aircraft_id}}
  body: none
  auth: bearer
}

params:query {
  aircraft_id: {{aircraft_id}}
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("all rows have aircraft_id == filtered value", function() {
    const expected = Number(bru.getEnvVar("aircraft_id"));
    const allMatch = res.getBody().every(s => s.aircraft_id === expected);
    expect(allMatch).to.equal(true);
  });
}
