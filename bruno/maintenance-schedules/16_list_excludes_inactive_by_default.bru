meta {
  name: 16 List Excludes Inactive by Default
  type: http
  seq: 16
}

get {
  url: {{base_url}}/api/v1/maintenance-schedules
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("deleted schedule_id is NOT in the response", function() {
    const deletedId = Number(bru.getEnvVar("schedule_id"));
    const ids = res.getBody().map(s => s.id);
    expect(ids.includes(deletedId)).to.equal(false);
  });
}
