meta {
  name: 03 Batch import — within-file dedupe + silent skip empty content
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/fleet/batch-import
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:multipart-form {
  entity_type: controller
  file: @file(../backend/tests/fixtures/qr_csv/bineye_with_dupes.csv)
}

tests {
  test("status is 200", function() { expect(res.getStatus()).to.equal(200); });
  test("5 total rows scanned", function() {
    expect(res.getBody().total_rows).to.equal(5);
  });
  test("2 unique SNs survive", function() {
    expect(res.getBody().total_parsed).to.equal(2);
  });
  test("2 within-file duplicates removed", function() {
    expect(res.getBody().duplicates_removed).to.equal(2);
  });
  test("empty content row is silent skip (no error reported)", function() {
    expect(res.getBody().errors.length).to.equal(0);
  });
}

docs {
  Within-file dedupe path. The fixture has the same SN scanned three
  times, plus one other unique SN, plus one row with empty `content`.
  The empty row is silently skipped (NOT reported as an error per the
  Binary Eye spec); the duplicates collapse to one occurrence.
}
