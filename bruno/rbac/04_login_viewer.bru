meta {
  name: 04 Login viewer (seeds viewer_token)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "rbac-viewer@dronefleetpro.local",
    "password": "dronefleet2025"
  }
}

docs {
  Run bruno/rbac/fixtures.sql first to seed the RVI user.
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody() && res.getBody().token) {
    bru.setEnvVar("viewer_token", res.getBody().token);
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("viewer_token stored", function() {
    expect(bru.getEnvVar("viewer_token")).to.be.a('string').and.not.empty;
  });
}
