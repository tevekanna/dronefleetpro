meta {
  name: 32 Admin creates second incident (seeds rbac_incident_id2)
  type: http
  seq: 32
}

post {
  url: {{base_url}}/api/v1/incidents
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
    "occurred_at": "2026-04-15T15:30:00Z",
    "severity": "low",
    "category": "RBAC test",
    "description": "RBAC suite test incident #2 — for tech-cannot-close test"
  }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody() && res.getBody().id) {
    bru.setEnvVar("rbac_incident_id2", res.getBody().id);
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
