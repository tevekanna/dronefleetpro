}

post {
  url: {{base_url}}/api/v1/aircraft
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{viewer_token}}
}

body:json {
  {
    "serial_number": "RBAC-VIEWER-DENY-001",
    "model": "DJI Air 2s"
  }
}

tests {
  test("status is 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
