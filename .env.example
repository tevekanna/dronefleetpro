# DroneFleetPro v2 — Environment Variables
# Copy this file to .env and fill in all values before starting.
# Never commit .env to git.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=choose_a_strong_password_here
DATABASE_URL=postgresql://dronefleet:${DB_PASSWORD}@db:5432/dronefleet

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_string

# ─── First admin password (startup bootstrap) ────────────────────────────────
# A new installation is seeded with one admin account,
# admin@dronefleetpro.local, whose seed password is public. The backend
# neutralises it on every start:
#   - Set:   the seed password is replaced with this value (minimum 12
#            characters). Log in with it, then change it in Settings.
#   - Unset: the account is locked and a one-time set-password link is
#            written to the backend log (docker compose logs backend).
# Only accounts that still carry the seed password are affected; once none
# does, this variable is ignored and can be removed.
# docker-compose.yml passes it through to the backend; leave it unset to use
# the one-time link.
# DFP_BOOTSTRAP_ADMIN_PASSWORD=

# ─── DJI Developer API ────────────────────────────────────────────────────────
# Optional: global fallback API key for DJI log decryption.
# Can also be set per-organisation in the Settings page.
DJI_API_KEY_GLOBAL=

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ─── Application ──────────────────────────────────────────────────────────────
RUST_LOG=info
# RUST_LOG=debug   ← use during development for verbose output

# ─── CORS (release builds only) ───────────────────────────────────────────────
# Comma-separated list of allowed browser origins. ONLY used in release builds;
# debug builds (Dockerfile.dev / cargo run) are dev-permissive and allow any
# origin. Defaults to http://localhost:5173 if unset. Production must list
# its own public origin here (dfp.example.com below is a placeholder). Must
# NOT resolve to an empty list (the server refuses to start if it does).
CORS_ORIGINS=http://localhost:5173,https://dfp.example.com

# ─── Source-code link (frontend build time) ───────────────────────────────────
# DroneFleetPro is licensed under AGPL-3.0-only. The application shows a
# "Source code (AGPL-3.0)" link in the sidebar and on the login page, which
# defaults to https://github.com/tevekanna/dronefleetpro. If you run a
# MODIFIED version, the licence requires you to offer your users the source
# of that version: set this to the URL of your own source before building
# the frontend. It is read at build time (docker compose passes it to the
# frontend image as a build argument), so rebuild the frontend after a change.
# VITE_SOURCE_CODE_URL=https://git.example.com/your-org/dronefleetpro

# ─── Auth rate limiting ───────────────────────────────────────────────────────
# IP-based rate limiter on the credential endpoints (/auth/login,
# /auth/redeem-token, /auth/change-password). Steady state: 1 token per
# RATE_LIMIT_AUTH_PER_SECONDS seconds with a RATE_LIMIT_AUTH_BURST-cell bucket.
# Defaults 12 / 6 ≈ 5 attempts before a 429, replenishing ~5/min. Raise both in
# dev/test if API suites make many auth calls per run. (Separate from the
# per-username login-attempt window, which is hardcoded.)
RATE_LIMIT_AUTH_PER_SECONDS=12
RATE_LIMIT_AUTH_BURST=6
